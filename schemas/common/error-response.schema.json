{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boutique.example.com/schemas/common/error-response.schema.json",
  "title": "ProblemDetail",
  "description": "Standard API error response based on RFC 9457 Problem Details.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "title",
    "status",
    "detail"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string"
    },
    "instance": {
      "type": "string"
    },
    "traceId": {
      "type": "string",
      "description": "Request trace identifier used for troubleshooting."
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
