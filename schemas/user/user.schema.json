{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boutique.example.com/schemas/user/user.schema.json",
  "title": "User",
  "description": "Public user profile returned by the User Service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "email",
    "firstName",
    "lastName",
    "status",
    "createdAt",
    "updatedAt",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable internal user identifier."
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 320
    },
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "phoneNumber": {
      "type": ["string", "null"],
      "maxLength": 30
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE",
        "SUSPENDED"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "description": "Optimistic-locking version."
    }
  }
}
